<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Pattern uses Logback's %replace converter to mask Clockify token shapes
        before they reach the appender. Two redactions:
          1. JWT-like base64url triplets (header.payload.signature).
          2. authToken=... fragments (case-insensitive, value up to whitespace
             or quote).
    -->

    <property name="REDACTED_PATTERN_BASE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%replace(%replace(%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n){'eyJ[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+','&lt;REDACTED-JWT&gt;'}){'(?i)(authToken|X-Addon-Token|X-Addon-Lifecycle-Token|Clockify-Signature)([=:]\s*"?)([A-Za-z0-9._\-+/=]{8,})','$1$2&lt;REDACTED&gt;'}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="me.apet97.breakcompliance" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

</configuration>
